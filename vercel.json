{
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Content-Security-Policy", "value": "default-src 'self'; script-src 'self' 'unsafe-inline' https://www.googletagmanager.com https://www.google-analytics.com; connect-src 'self' https://www.google-analytics.com https://region1.google-analytics.com; img-src 'self' data: https:; style-src 'self' 'unsafe-inline'; font-src 'self' data: https:; frame-ancestors 'self'; base-uri 'self'; form-action 'self' mailto: tel:" }
      ]
    },
    {
      "source": "/blog/top-8-digital-marketing-agencies-in-ahmedabad",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    },
    {
      "source": "/blog/smart-objectives-competitive-benchmarking",
      "headers": [
        {
          "key": "Link",
          "value": "</blog/smart-objectives-competitive-benchmarking/layout-fix.css>; rel=stylesheet"
        }
      ]
    }
  ],
  "routes": [
    {
      "src": "^/blog/top-8-digital-marketing-agencies-in-ahmedabad/?$",
      "dest": "/agency-guide-ahmedabad.html"
    },
    {
      "src": "^/blog/digital-marketing-packages-in-ahmedabad/?$",
      "dest": "/blog/digital-marketing-packages-in-ahmedabad/index.html"
    },
    {
      "src": "^/blog/google-ads-vs-meta-ads-ahmedabad/?$",
      "dest": "/blog/google-ads-vs-meta-ads-ahmedabad/index.html"
    },
    {
      "src": "^/blog/seo-for-real-estate-businesses-in-ahmedabad/?$",
      "dest": "/blog/seo-for-real-estate-businesses-in-ahmedabad/index.html"
    },
    {
      "src": "^/blog/how-to-read-google-analytics-search-console-without-an-agency/?$",
      "dest": "/blog/how-to-read-google-analytics-search-console-without-an-agency/index.html"
    },
    {
      "src": "^/blog/smart-objectives-competitive-benchmarking/?$",
      "dest": "/blog/smart-objectives-competitive-benchmarking/index.html"
    },
    {
      "src": "^/blog/first-year-startup-marketing-budget/?$",
      "dest": "/blog/first-year-startup-marketing-budget/index.html"
    },
    {
      "src": "^/blog/google-ads-optimization-moves-experts/?$",
      "dest": "/blog/google-ads-optimization-moves-experts/index.html"
    },
    {
      "src": "^/blog/?$",
      "dest": "/blog/index.html"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "^/(.*)$",
      "dest": "/index.html"
    }
  ]
}
